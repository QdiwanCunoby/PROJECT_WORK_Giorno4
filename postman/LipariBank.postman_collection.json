                  "pm.test(\"VALIDATION_ERROR con details\", () => {",
                  "  const { error } = pm.response.json();",
                  "  pm.expect(error.code).to.eql(\"VALIDATION_ERROR\");",
                  "  pm.expect(error.details.map(d => d.field)).to.include.members([\"ownerId\", \"iban\", \"type\", \"initialBalance\"]);",
                  "});"
                ]
