    {
      "name": "Errori (G4)",
      "item": [
        {
          "name": "POST account body invalido → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
