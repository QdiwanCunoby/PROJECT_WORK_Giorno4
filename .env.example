# development | test | production — decide anche il livello di log (debug | silent | info)
NODE_ENV=development
PORT=3000
# Origini ammesse da CORS, separate da virgola
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Opzionale: sovrascrive il livello di log derivato da NODE_ENV (trace|debug|info|warn|error|fatal|silent)
# LOG_LEVEL=info
